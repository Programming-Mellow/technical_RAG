# Copy this file to .env and adjust values for your local setup.
# .env is gitignored — never commit it.

# ── LM Studio (Phase 1) ──────────────────────────────────────────────────────
# Start the server in LM Studio → Server tab → Start Server
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# ── Vector store ─────────────────────────────────────────────────────────────
CHROMA_DIR=./chroma_db

# ── Embedding model ───────────────────────────────────────────────────────────
# Must match the model used during ingest — changing this requires re-ingesting
EMBED_MODEL=all-MiniLM-L6-v2

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5

# ── Chunking (ingest.py) ──────────────────────────────────────────────────────
# 1600 chars ≈ 400 tokens at ~4 chars/token, within all-MiniLM-L6-v2's 512-token limit
CHUNK_SIZE=1600
CHUNK_OVERLAP=200

# ── AWS (Phase 3+) ────────────────────────────────────────────────────────────
# Uncomment and fill in when moving to AWS deployment
# AWS_REGION=us-east-1
# OPENSEARCH_ENDPOINT=https://<your-collection>.us-east-1.aoss.amazonaws.com
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
